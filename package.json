{
  "name": "wishfy-website-stack",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Wishfy baseline website build stack and hello-client template.",
  "scripts": {
    "dev": "npm run tokens:build && astro dev",
    "start": "astro dev",
    "build": "npm run tokens:build && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "tokens:build": "tsx scripts/build-tokens.ts",
    "tokens:verify": "tsx scripts/build-tokens.ts --check"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "astro": "^5.1.1"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0"
  }
}
