# Public canonical site URL. Used for canonical tags, sitemap, OG image URLs.
# Override per client (e.g. https://acme.com).
SITE_URL=https://hello-client.pages.dev

# Cloudflare Web Analytics token. Get from Cloudflare dashboard → Analytics → Web Analytics.
# Leave blank to disable analytics on builds where it should not run.
PUBLIC_CF_ANALYTICS_TOKEN=
