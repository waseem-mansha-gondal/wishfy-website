---
import '@/styles/base.css';
import { organizationSchema, websiteSchema } from '@/lib/schema';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  canonicalUrl?: string;
  jsonLd?: unknown[];
}

const {
  title,
  description = 'Wishfy makes your business the obvious answer in Google, ChatGPT, Claude, Perplexity, and every search that matters.',
  lang = 'en',
  canonicalUrl,
  jsonLd = [],
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://wishfy.ai');
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, siteUrl).toString();

// Every page gets Organization + WebSite schema (Brief §6).
const allSchemas = [organizationSchema(siteUrl), websiteSchema(siteUrl), ...jsonLd];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <!-- Preload variable font -->
    <link
      rel="preload"
      href="/fonts/mona-sans/MonaSans-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <meta name="generator" content={Astro.generator} />
    {
      allSchemas.map((s) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(s)}
        />
      ))
    }
  </head>
  <body class="min-h-screen bg-[var(--bg-surface)] text-[var(--text-primary)]">
    <slot />
  </body>
</html>
