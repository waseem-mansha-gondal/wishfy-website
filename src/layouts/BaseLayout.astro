---
import BaseHead from "../components/BaseHead.astro";
import { SITE } from "../consts";
import {
  DEFAULT_LOCALE,
  getDirection,
  getStrings,
  type Locale,
} from "../lib/i18n";

interface Props {
  title: string;
  description?: string;
  /**
   * Page locale. Drives <html lang>, <html dir>, og:locale, hreflang
   * generation, and schema `inLanguage`. Defaults to the project default so
   * legacy single-language pages keep working during the i18n rollout.
   */
  locale?: Locale;
  /**
   * Sub-path of this page *without* the locale prefix — used to build
   * hreflang alternates. Pass the same sub-path you would localize for any
   * other locale, e.g. `/services/seo/`. Defaults to the current request's
   * sub-path with the locale segment stripped.
   *
   * Pass `translations` to opt into hreflang for ONLY the locales that have
   * a real translated equivalent (per i18n-Strategy.md §3).
   */
  translations?: Partial<Record<Locale, string>>;
}

const { title, description, locale = DEFAULT_LOCALE, translations } = Astro.props;

const strings = getStrings(locale);
const fullTitle = title === SITE.name ? title : `${title} — ${SITE.name}`;
---

<!doctype html>
<html lang={strings.htmlLang} dir={getDirection(locale)}>
  <head>
    <BaseHead
      title={fullTitle}
      description={description}
      locale={locale}
      translations={translations}
    />
  </head>
  <body>
    <main>
      <slot />
    </main>
    <style is:global>
      :root {
        color-scheme: light dark;
        --fg: #0f172a;
        --bg: #ffffff;
        --accent: #f59e0b;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --fg: #f1f5f9;
          --bg: #0f172a;
        }
      }
      html,
      body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--fg);
        font-family:
          ui-sans-serif,
          system-ui,
          -apple-system,
          "Segoe UI",
          Roboto,
          "Helvetica Neue",
          Arial,
          sans-serif;
        line-height: 1.6;
      }
      main {
        max-width: 720px;
        margin: 0 auto;
        padding: 4rem 1.25rem;
      }
      h1 {
        font-size: clamp(2rem, 4vw + 1rem, 3rem);
        line-height: 1.15;
        margin: 0 0 1rem;
      }
      a {
        color: var(--accent);
      }
    </style>
  </body>
</html>
