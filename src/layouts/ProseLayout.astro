---
import BaseLayout from "./BaseLayout.astro";
import Container from "../components/Container.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  jsonLd?: unknown[];
}

const { title, description, ogImage, jsonLd } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <article class="prose-wrap">
    <Container size="narrow">
      <slot />
    </Container>
  </article>
</BaseLayout>

<style is:global>
  .prose-wrap {
    padding: var(--space-8) 0 var(--space-9);
  }
  .prose-wrap h1 {
    margin-top: 0;
  }
  .prose-wrap h2 {
    margin-top: var(--space-7);
  }
  .prose-wrap h3 {
    margin-top: var(--space-6);
  }
  .prose-wrap ul,
  .prose-wrap ol {
    padding-left: 1.25rem;
  }
  .prose-wrap li {
    margin: var(--space-2) 0;
  }
  .prose-wrap a {
    color: var(--link);
  }
  .prose-wrap .meta {
    color: var(--fg-subtle);
    font-size: var(--text-sm);
    margin: 0 0 var(--space-4);
  }
  .prose-wrap .meta a {
    color: var(--fg-subtle);
    text-decoration: none;
  }
  .prose-wrap .meta a:hover {
    color: var(--accent);
  }
</style>
