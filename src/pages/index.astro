---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Section from "../components/Section.astro";
import Hero from "../components/Hero.astro";
import Button from "../components/Button.astro";
import { SITE } from "../consts";

const services = (await getCollection("services", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const cases = (
  await getCollection("case-studies", ({ data }) => !data.draft)
).sort((a, b) => +b.data.pubDate - +a.data.pubDate);

const recentPosts = (
  await getCollection("blog", ({ data }) => !data.draft)
)
  .sort((a, b) => +b.data.pubDate - +a.data.pubDate)
  .slice(0, 3);
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <Section>
    <Container>
      <Hero
        eyebrow="Marketing sites that earn their keep"
        title={SITE.tagline}
        lede="We design, build, and ship content-led marketing sites on a stack that's fast by default and easy for your team to maintain."
      >
        <Button href="/contact/">Start a project</Button>
        <Button href="/services/" variant="ghost">See services →</Button>
      </Hero>
    </Container>
  </Section>

  <Section tone="muted">
    <Container>
      <h2>What we do</h2>
      <ul class="cards">
        {
          services.slice(0, 3).map((s) => (
            <li>
              <a href={`/services/${s.slug}/`}>
                <span class="icon" aria-hidden="true">
                  {s.data.icon ?? "→"}
                </span>
                <h3>{s.data.title}</h3>
                <p>{s.data.summary}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </Section>

  {
    cases.length > 0 && (
      <Section>
        <Container>
          <h2>Recent work</h2>
          <ul class="cards">
            {cases.slice(0, 2).map((c) => (
              <li>
                <a href={`/case-studies/${c.slug}/`}>
                  <p class="kicker">{c.data.client}</p>
                  <h3>{c.data.title}</h3>
                  <p>{c.data.summary}</p>
                </a>
              </li>
            ))}
          </ul>
        </Container>
      </Section>
    )
  }

  {
    recentPosts.length > 0 && (
      <Section tone="muted">
        <Container>
          <h2>From the blog</h2>
          <ul class="post-list">
            {recentPosts.map((p) => (
              <li>
                <a href={`/blog/${p.slug}/`}>
                  <span>{p.data.title}</span>
                  <span class="post-date">
                    {p.data.pubDate.toISOString().slice(0, 10)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </Container>
      </Section>
    )
  }
</BaseLayout>

<style>
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .cards li > a {
    display: block;
    padding: var(--space-5);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: inherit;
    text-decoration: none;
    height: 100%;
    transition:
      transform var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }
  .cards li > a:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent);
  }
  .icon {
    font-size: var(--text-2xl);
    display: block;
    margin-bottom: var(--space-3);
  }
  .cards h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }
  .cards p {
    color: var(--color-fg-muted);
    margin: 0;
  }
  .kicker {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-border);
  }
  .post-list li {
    border-bottom: 1px solid var(--color-border);
  }
  .post-list a {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    color: var(--color-fg);
    text-decoration: none;
  }
  .post-list a:hover {
    color: var(--color-link);
  }
  .post-date {
    color: var(--color-fg-subtle);
    font-variant-numeric: tabular-nums;
    font-size: var(--text-sm);
  }
</style>
