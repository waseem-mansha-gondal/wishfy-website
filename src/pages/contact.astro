---
import ProseLayout from "../layouts/ProseLayout.astro";
import { breadcrumbSchema } from "../lib/schema";
import { SITE } from "../consts";

const siteUrl = Astro.site ?? new URL("https://hello-client.pages.dev");
const jsonLd = [
  breadcrumbSchema(siteUrl, [
    { name: "Home", url: "/" },
    { name: "Contact", url: "/contact/" },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: `Contact ${SITE.name}`,
    url: new URL("/contact/", siteUrl).toString(),
  },
];
---

<ProseLayout
  title="Contact"
  description={`Get in touch with ${SITE.name}.`}
  jsonLd={jsonLd}
>
  <h1>Get in touch</h1>
  <p class="meta">
    The fastest way to reach us is email. We reply within one business day.
  </p>

  <p>
    Email us at
    <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>. Tell us
    what you're trying to ship, when you'd like it live, and a link or two
    that captures the look and feel you're after. We'll come back with a
    rough plan and a price band within a day.
  </p>

  <h2>What happens next</h2>
  <ol>
    <li>We reply with a few clarifying questions.</li>
    <li>We schedule a 30-minute call to align on scope.</li>
    <li>You get a written proposal with timeline and price.</li>
    <li>If we're a fit, we start the week after sign-off.</li>
  </ol>

  <p>
    Prefer a form? Wire one to a server endpoint that posts to Resend — the
    Wishfy stack supports it but doesn't ship one by default (one less moving
    part for the first launch).
  </p>
</ProseLayout>
