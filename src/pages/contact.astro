---
import ProseLayout from "../layouts/ProseLayout.astro";
import Button from "../components/Button.astro";
import { breadcrumbSchema } from "../lib/schema";
import { SITE } from "../consts";

const siteUrl = Astro.site ?? new URL("https://wishfy.ai");
const url = "/contact/";
const subject = encodeURIComponent("New enquiry from wishfy.ai");
const body = encodeURIComponent(
  [
    "Hi Wishfy team,",
    "",
    "Company:",
    "Website:",
    "What I'm trying to ship:",
    "Timeline:",
    "Budget tier (Starter / Growth / Scale):",
    "",
    "Thanks,",
  ].join("\n"),
);
const mailto = `mailto:${SITE.contactEmail}?subject=${subject}&body=${body}`;
const wa = `https://wa.me/${SITE.whatsappNumber}?text=${encodeURIComponent(
  "Hi Wishfy, I'd like to talk about a visibility audit.",
)}`;

const jsonLd = [
  breadcrumbSchema(siteUrl, [
    { name: "Home", url: "/" },
    { name: "Contact", url },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: `Contact ${SITE.name}`,
    url: new URL(url, siteUrl).toString(),
    inLanguage: SITE.locale,
  },
];
---

<ProseLayout
  title="Contact"
  description={`Get in touch with ${SITE.name}. Email, WhatsApp, or send us a brief — we reply within one business day.`}
  jsonLd={jsonLd}
>
  <h1>Get in touch</h1>
  <p class="lede">
    The fastest way to reach us is email or WhatsApp. We reply within one
    business day.
  </p>

  <div class="channels">
    <a class="card" href={mailto}>
      <p class="kicker">Email</p>
      <p class="value">{SITE.contactEmail}</p>
      <p class="hint">Pre-filled with the brief we need to get started →</p>
    </a>
    <a class="card" href={wa} rel="noopener">
      <p class="kicker">WhatsApp</p>
      <p class="value">Chat with Waseem</p>
      <p class="hint">Best for quick questions and async time zones →</p>
    </a>
  </div>

  <h2>What to send us</h2>
  <p>To get a useful answer back quickly, include:</p>
  <ul>
    <li><strong>Company and website</strong> (or what you're planning to build)</li>
    <li><strong>What you're trying to ship</strong> — visibility, retainer, build, or audit</li>
    <li><strong>Timeline</strong> — when you'd like the work live</li>
    <li><strong>Budget tier</strong> — Starter / Growth / Scale, or a range</li>
    <li><strong>Anything you've already tried</strong> — keeps us from repeating dead-ends</li>
  </ul>

  <h2>What happens next</h2>
  <ol>
    <li>We reply with a few clarifying questions (often same day).</li>
    <li>We schedule a 30-minute discovery call to align on scope.</li>
    <li>You get a written proposal with timeline, deliverables, and a price band.</li>
    <li>If we're a fit, kickoff is the week after sign-off.</li>
  </ol>

  <h2>Office hours and time zone</h2>
  <p>
    We work primarily in <strong>CET (Amsterdam)</strong>, with async support
    across Europe and the Americas. WhatsApp responses are typically within a
    few hours during the working week.
  </p>

  <hr />
  <div class="actions">
    <Button href={mailto}>Email {SITE.contactEmail}</Button>
    <Button href={wa} variant="whatsapp" rel="noopener">Chat on WhatsApp</Button>
  </div>
</ProseLayout>

<style>
  .lede {
    font-size: var(--text-lg);
    color: var(--fg-muted);
    margin-bottom: var(--space-6);
  }
  .channels {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    margin: var(--space-6) 0;
  }
  .card {
    display: block;
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    background: var(--bg);
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .card:hover {
    border-color: var(--accent);
  }
  .card .kicker {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: var(--text-xs);
    color: var(--accent);
    margin: 0 0 var(--space-2);
    font-weight: 600;
  }
  .card .value {
    font-size: var(--text-lg);
    font-weight: 600;
    margin: 0 0 var(--space-2);
  }
  .card .hint {
    color: var(--fg-muted);
    font-size: var(--text-sm);
    margin: 0;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
