---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Wishfy — AI-Native Search Visibility"
  description="Wishfy makes your business the obvious answer in Google, ChatGPT, Claude, Perplexity, and every search that matters."
  lang="en"
>
  <main>
    <section style="min-height:100dvh;display:flex;align-items:center;justify-content:center;padding:2rem;text-align:center;">
      <div>
        <p style="font-size:13px;letter-spacing:0.05em;text-transform:uppercase;color:#3B82F6;font-weight:600;margin-bottom:1rem;">
          AI-NATIVE SEARCH VISIBILITY
        </p>
        <h1 style="font-size:clamp(48px,8vw,110px);font-weight:800;line-height:1.05;margin-bottom:1.5rem;">
          Where Ideas Meet<br />AI Precision.
        </h1>
        <p style="font-size:clamp(18px,2.5vw,24px);line-height:1.5;color:rgba(255,255,255,0.65);max-width:640px;margin:0 auto 2.5rem;">
          Wishfy makes your business the obvious answer in Google, ChatGPT, Claude, Perplexity, and every search that matters in 2026.
          Get found. Get cited. Get chosen.
        </p>
        <p style="font-size:13px;color:rgba(255,255,255,0.4);">
          🚧 Site under construction — launching soon.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
