---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import Section from '@/components/Section.astro';
import Hero from '@/components/Hero.astro';
import Button from '@/components/Button.astro';
import { SITE } from '@/lib/consts';

const services = [
  {
    slug: 'content-ignition',
    title: 'Content Ignition',
    tag: 'One-off launch — $6,500',
    summary:
      'Audit, 12-week editorial plan, and four optimised long-form articles. The foundation a content engine needs before it commits to a retainer.',
  },
  {
    slug: 'content-growth',
    title: 'Content Growth',
    tag: 'Retainer — $4,500/mo',
    summary:
      'Four long-form articles a month with strategy, internal-linking, and an outcomes report. The compounding engagement for teams ready to publish.',
  },
  {
    slug: 'content-authority',
    title: 'Content Authority',
    tag: 'Retainer — $8,500/mo',
    summary:
      'Eight articles plus two citable assets monthly, plus GEO/AEO layer to earn citations across ChatGPT, Claude, Perplexity, and Gemini.',
  },
];

const kpis = [
  { label: 'LLM surfaces tracked', value: '4' },
  { label: 'Days to first wins', value: '30' },
  { label: 'Languages supported', value: 'EN · NL · DE · FR' },
];

const whyWishfy = [
  {
    title: 'We measure outcomes, not activity.',
    body: 'Reports come with decisions, not dashboards. Every recommendation ships in under a week.',
  },
  {
    title: 'We ship code, not just decks.',
    body: "When the strategy points to your site as the problem, we fix it — schema, build, and copy.",
  },
  {
    title: "We refuse what doesn't deserve to rank.",
    body: 'No PBNs, no AI-spam. Honest content, citable signals, and entity authority that compounds.',
  },
];
---

<BaseLayout
  title={`${SITE.name} — AI-Native Search Visibility`}
  description={SITE.description}
  lang="en"
>
  <main>
    <Section>
      <Container>
        <Hero
          eyebrow="AI-native search visibility"
          title={SITE.tagline}
          lede="Wishfy makes your business the obvious answer in Google, ChatGPT, Claude, Perplexity, and every search that matters in 2026. Get found. Get cited. Get chosen."
        >
          <Button href="/en/contact/">Book a visibility audit →</Button>
          <Button href="/en/services/" variant="ghost">See services</Button>
        </Hero>
      </Container>
    </Section>

    <Section tone="muted">
      <Container>
        <ul class="grid list-none gap-5 p-0 m-0 grid-cols-1 sm:grid-cols-3">
          {
            kpis.map((k) => (
              <li>
                <p class="font-display text-h2 font-bold text-[var(--text-accent)] m-0">
                  {k.value}
                </p>
                <p class="text-body-sm text-[var(--text-secondary)] m-0">
                  {k.label}
                </p>
              </li>
            ))
          }
        </ul>
      </Container>
    </Section>

    <Section>
      <Container>
        <p
          class="mb-3 text-footnote font-semibold uppercase tracking-[0.08em] text-[var(--text-accent)]"
        >
          What we do
        </p>
        <h2
          class="mb-4 font-display text-h2 font-bold leading-tight text-[var(--text-primary)]"
        >
          Three productized content packages.
        </h2>
        <p class="mb-10 max-w-prose text-body-lg text-[var(--text-secondary)]">
          We picked three packages, not a menu. Each one has explicit deliverables
          and an honest price. If a need falls between them, we scope down within
          a tier — we don't invent new ones.
        </p>
        <ul
          class="grid list-none gap-5 p-0 m-0 grid-cols-1 md:grid-cols-3"
        >
          {
            services.map((s) => (
              <li>
                <a
                  href={`/en/services/${s.slug}/`}
                  class="block h-full rounded-lg border border-[var(--border-default)] bg-[var(--bg-surface)] p-6 transition duration-[var(--motion-default)] ease-[var(--easing-default)] hover:-translate-y-0.5 hover:border-[var(--text-accent)]"
                >
                  <p class="mb-2 text-footnote font-semibold uppercase tracking-[0.06em] text-[var(--text-accent)]">
                    {s.tag}
                  </p>
                  <h3 class="mb-3 text-h4 font-bold text-[var(--text-primary)]">
                    {s.title}
                  </h3>
                  <p class="mb-4 text-body text-[var(--text-secondary)]">
                    {s.summary}
                  </p>
                  <p class="m-0 font-semibold text-[var(--link)]">
                    Learn more →
                  </p>
                </a>
              </li>
            ))
          }
        </ul>
      </Container>
    </Section>

    <Section tone="muted">
      <Container>
        <p
          class="mb-3 text-footnote font-semibold uppercase tracking-[0.08em] text-[var(--text-accent)]"
        >
          Why Wishfy
        </p>
        <ul class="grid list-none gap-5 p-0 m-0 grid-cols-1 md:grid-cols-3">
          {
            whyWishfy.map((row) => (
              <li>
                <h3 class="mb-2 text-h5 font-bold text-[var(--text-primary)]">
                  {row.title}
                </h3>
                <p class="m-0 text-body text-[var(--text-secondary)]">
                  {row.body}
                </p>
              </li>
            ))
          }
        </ul>
      </Container>
    </Section>

    <Section>
      <Container>
        <div
          class="mx-auto max-w-2xl rounded-lg border border-[var(--border-default)] p-8 text-center"
        >
          <h2
            class="mb-3 font-display text-h2 font-bold leading-tight text-[var(--text-primary)]"
          >
            Ready to be the obvious answer?
          </h2>
          <p class="mb-6 text-body-lg text-[var(--text-secondary)]">
            Book a 20-minute visibility audit. We'll come back with a written plan
            and an honest price band within one business day.
          </p>
          <div class="flex flex-wrap justify-center gap-3">
            <Button href="/en/contact/">Book now →</Button>
            <Button
              href={`https://wa.me/${SITE.whatsappNumber}`}
              variant="whatsapp"
              rel="noopener"
            >
              Chat on WhatsApp
            </Button>
          </div>
        </div>
      </Container>
    </Section>
  </main>
</BaseLayout>
