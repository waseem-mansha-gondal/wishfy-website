---
/**
 * Section — a vertically-padded full-width band with an optional surface
 * background. Drop a <Container> inside for centred content.
 */
interface Props {
  tone?: "default" | "muted" | "accent";
  as?: "section" | "div" | "article" | "aside" | "main" | "nav";
  class?: string;
}

const { tone = "default", as: Tag = "section", class: cls = "" } = Astro.props;
---

<Tag class:list={["section", `section--${tone}`, cls]}>
  <slot />
</Tag>

<style>
  .section {
    padding-block: var(--space-10);
  }
  @media (min-width: 768px) {
    .section {
      padding-block: var(--space-12);
    }
  }
  .section--muted {
    background: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }
  .section--accent {
    background: var(--color-fg);
    color: var(--color-bg);
  }
  .section--accent :global(h1),
  .section--accent :global(h2),
  .section--accent :global(h3) {
    color: var(--color-bg);
  }
  .section--accent :global(a) {
    color: var(--color-accent);
  }
</style>
