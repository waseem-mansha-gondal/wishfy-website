---
/**
 * Language switcher (WIS-14 / i18n-Strategy.md §8).
 *
 * Renders one link per launch locale. The link goes to the equivalent page
 * in the target locale — caller supplies `translations` (a sub-path-per-
 * locale map) so we know where to send users for pages whose slugs differ
 * across languages. For chrome pages where every locale uses the same sub-
 * path, omit `translations` and the current request's sub-path is reused.
 *
 * Clicking a link also persists the choice to the `wishfy_lang` cookie so
 * the root language router at `/` honours it on the next visit. The cookie
 * write is a tiny inline script — no extra request, no tracking.
 */
import {
  LANG_COOKIE,
  LANG_COOKIE_MAX_AGE,
  getStrings,
  getSwitcherLinks,
  stripLocaleFromPath,
  type Locale,
} from "../lib/i18n";

interface Props {
  /** Current page locale — used to bold/aria-current the active language. */
  current: Locale;
  /**
   * Optional explicit per-locale sub-paths. When omitted, the current
   * request's path-after-the-locale is reused for each language. Set this
   * when slugs differ per locale (most content pages will).
   */
  translations?: Partial<Record<Locale, string>>;
}

const { current, translations } = Astro.props;
const strings = getStrings(current);

const subPath = stripLocaleFromPath(Astro.url.pathname);
const effectiveTranslations: Partial<Record<Locale, string>> = translations ?? {
  en: subPath,
  nl: subPath,
  de: subPath,
  fr: subPath,
};

const links = getSwitcherLinks(current, effectiveTranslations);
---

<nav aria-label={strings.ui.languageSwitcher} class="lang-switcher">
  <ul>
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            hreflang={link.locale}
            lang={link.locale}
            data-locale={link.locale}
            aria-current={link.isCurrent ? "true" : undefined}
            aria-label={
              link.isCurrent
                ? `${strings.ui.currentLanguage}: ${link.name}`
                : strings.ui.switchTo.replace("{language}", link.name)
            }
          >
            {link.shortName}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script
  is:inline
  define:vars={{ LANG_COOKIE, LANG_COOKIE_MAX_AGE }}
>
  document.querySelectorAll(".lang-switcher [data-locale]").forEach((node) => {
    node.addEventListener("click", () => {
      const locale = node.getAttribute("data-locale");
      if (!locale) return;
      // First-party preference cookie (i18n-Strategy.md §2). SameSite=Lax so
      // it survives top-level navigations; Secure because the site is HTTPS.
      const attrs = [
        `${LANG_COOKIE}=${encodeURIComponent(locale)}`,
        "Path=/",
        `Max-Age=${LANG_COOKIE_MAX_AGE}`,
        "SameSite=Lax",
        ...(location.protocol === "https:" ? ["Secure"] : []),
      ];
      document.cookie = attrs.join("; ");
    });
  });
</script>

<style>
  .lang-switcher ul {
    display: inline-flex;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.875rem;
  }
  .lang-switcher a {
    color: inherit;
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    opacity: 0.7;
  }
  .lang-switcher a:hover,
  .lang-switcher a:focus-visible {
    opacity: 1;
  }
  .lang-switcher a[aria-current="true"] {
    opacity: 1;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }
</style>
