---
/**
 * Container — centred max-width wrapper used for almost every block.
 * Pass `width="prose"` for long-form text content (narrower).
 */
interface Props {
  width?: "default" | "prose";
  as?: "section" | "div" | "article" | "aside" | "main" | "nav";
  class?: string;
}

const { width = "default", as: Tag = "div", class: cls = "" } = Astro.props;
---

<Tag class:list={["container", `container--${width}`, cls]}>
  <slot />
</Tag>

<style>
  .container {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--space-5);
  }
  .container--default {
    max-width: var(--container-max);
  }
  .container--prose {
    max-width: var(--prose-max);
  }
</style>
