---
import "../styles/tokens.css";
import "../styles/base.css";
import { SITE } from "../consts";
import { organizationSchema, websiteSchema } from "../lib/schema";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  jsonLd?: unknown[];
}

const {
  title,
  description = SITE.description,
  ogImage = "/og-default.png",
  jsonLd = [],
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://wishfy.ai");
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();

const sitewideJsonLd = [organizationSchema(siteUrl), websiteSchema(siteUrl)];
const allJsonLd = [...sitewideJsonLd, ...jsonLd];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content={SITE.themeColor} />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:locale" content={SITE.locale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
{SITE.twitterHandle && (
  <meta name="twitter:site" content={SITE.twitterHandle} />
)}

{
  allJsonLd.map((node) => (
    <script type="application/ld+json" set:html={JSON.stringify(node)} />
  ))
}
