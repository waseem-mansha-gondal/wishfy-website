---
import { SITE } from "../consts";
import { organizationSchema, websiteSchema } from "../lib/schema";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  /**
   * Extra JSON-LD entries injected as-is. Build with helpers from
   * `src/lib/schema.ts` (e.g. `breadcrumbSchema`, `articleSchema`).
   */
  jsonLd?: Array<Record<string, unknown>>;
  /** Mark the page as noindex (for drafts / utility pages). */
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  ogImage = "/og-default.png",
  ogType = "website",
  jsonLd = [],
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://hello-client.pages.dev");
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();
const cfToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;

const baseJsonLd = [organizationSchema(siteUrl), websiteSchema(siteUrl)];
const allJsonLd = [...baseJsonLd, ...jsonLd];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content={SITE.themeColor} />
{noindex && <meta name="robots" content="noindex,nofollow" />}

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:locale" content={SITE.locale} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
{SITE.twitterHandle && <meta name="twitter:site" content={SITE.twitterHandle} />}

<!-- JSON-LD -->
{
  allJsonLd.map((entry) => (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(entry).replace(/</g, "\\u003c")}
    />
  ))
}

{
  cfToken && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={JSON.stringify({ token: cfToken })}
    />
  )
}
